---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { Image } from 'astro:assets'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="rounded-lg border">
    <div class="p-6 grid grid-cols-1  justify-items-center sm:justify-items-end s">
      <div>
        <p class="text-muted-foreground mb-2 text-sm">
        2003's developer from Brazil. I work only with web and ocassionally try random things (AI, game dev...) when the routine is boring. I will use this blog as a place to practice my writing/teaching skills.
        </p>
        <p class="text-muted-foreground mb-2 text-sm">
          You can find me on <Link
            external
            class="text-foreground"
            underline
            href="https://github.com/joseiedo">GitHub</Link
          > and <Link
            external
            class="text-foreground"
            underline
            href="https://www.linkedin.com/in/joseiedo/">LinkedIn</Link
          >.
        </p>
      </div>
    </div>
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
