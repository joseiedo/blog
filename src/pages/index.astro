---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getRecentPosts } from '@/lib/data-utils'

const blog = await getRecentPosts(SITE.featuredPostCount)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <section class="rounded-lg border">
    <div class="p-6">
      <p class="text-muted-foreground mb-2 text-sm">
        I don't know what to write here. I started writing to see if I would
        improve my english writing (and reasoning) skills. No idea if it's
        working, but I think my posts are improving.
      </p>
      <p class="text-muted-foreground text-sm">Some facts about me:</p>
      <ul class="text-muted-foreground text-sm list-disc pl-5 mb-2">
        <li>My favorite fruit is Mango</li>
        <li>I try to draw and play guitar sometimes</li>
        <li>I'm a Brazilian with no good social skills</li>
      </ul>
      <p class="text-muted-foreground mb-2 text-sm">
        For now, I'm writing technical content that helps me or I can share with
        another person if it's a concept I don't have energy to answer again.
      </p>
      <p class="text-muted-foreground mb-2 text-sm">
        You can find me on <Link
          external
          class="text-foreground"
          underline
          href="https://github.com/joseiedo">GitHub</Link
        > and <Link
          external
          class="text-foreground"
          underline
          href="https://www.linkedin.com/in/joseiedo/">LinkedIn</Link
        >.
      </p>
    </div>
  </section>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Latest posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
